# Copy to apps/server/.env for local development.

# Pooled connection used by the running server (on Neon: the "-pooler" host).
DATABASE_URL="postgresql://taskly:taskly@localhost:5438/taskly"
# Direct connection used by `prisma migrate` (on Neon: the host without "-pooler"). Optional locally.
# DIRECT_DATABASE_URL=""

# Exact origins allowed to call the API and open the WebSocket, comma-separated.
WEB_ORIGINS="http://localhost:3020"
PORT=8030
